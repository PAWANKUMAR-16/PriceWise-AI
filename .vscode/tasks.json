{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run Backend (Spring Boot)",
      "type": "shell",
      "command": "$env:JAVA_HOME = 'C:\\Users\\LOQ\\tools\\jdk21'; $env:PATH = 'C:\\Users\\LOQ\\tools\\jdk21\\bin;' + $env:PATH; $env:SPRING_PROFILES_ACTIVE = 'dev'; $env:DATABASE_URL = 'jdbc:postgresql://localhost:5432/pricewise_db'; $env:DATABASE_USERNAME = 'pricewise_user'; $env:DATABASE_PASSWORD = 'pricewise_password'; $env:JWT_SECRET = 'pricewise-dev-secret-key-minimum-256-bits-long-for-hmac-sha256'; .\\mvnw.cmd spring-boot:run",

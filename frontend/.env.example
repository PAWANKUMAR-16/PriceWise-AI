# PriceWise AI Frontend Environment Configuration

# (Optional) Unsplash Access Key for live product image queries
# If not provided, PriceWise uses high-definition curated gadget photography
VITE_UNSPLASH_ACCESS_KEY=

# Backend API base URL (defaults to /api/v1 proxied to http://localhost:8080)
VITE_API_BASE_URL=/api/v1
